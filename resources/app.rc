#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "fubar.ico"

IDR_MAINMENU MENU
BEGIN
  POPUP "&Tools"
  BEGIN
    MENUITEM "&Settings...", ID_TOOLS_SETTINGS
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 276, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Maximum live listeners:", -1, 14, 16, 160, 10
  EDITTEXT IDC_LIVE_LIMIT, 180, 14, 40, 14, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Default is 5. Once this many people are listening live, new visitors wait in a queue until someone leaves. Lowering the number does not disconnect anyone already live.", -1, 14, 38, 248, 42
  LTEXT "", IDC_LIVE_STATS, 14, 84, 248, 12
  DEFPUSHBUTTON "OK", IDOK, 160, 108, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 214, 108, 50, 14
END
