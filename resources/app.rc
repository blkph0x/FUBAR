#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "fubar.ico"

IDR_MAINMENU MENU
BEGIN
  POPUP "&Tools"
  BEGIN
    MENUITEM "&Settings...", ID_TOOLS_SETTINGS
    MENUITEM "&Manage recordings...", ID_TOOLS_RECORDINGS
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 276, 276
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Maximum live listeners:", -1, 14, 14, 160, 10
  EDITTEXT IDC_LIVE_LIMIT, 180, 12, 40, 14, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Live listen boost (dB):", -1, 14, 34, 160, 10
  EDITTEXT IDC_LIVE_BOOST, 180, 32, 40, 14, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Delete recordings older than:", -1, 14, 54, 160, 10
  EDITTEXT IDC_PRUNE_DAYS, 180, 52, 40, 14, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "days  (0 = keep all)", -1, 226, 54, 44, 10
  LTEXT "Website port:", -1, 14, 74, 80, 10
  EDITTEXT IDC_WEB_PORT, 100, 72, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "default 80", -1, 156, 74, 60, 10
  LTEXT "Public hostname (optional):", -1, 14, 94, 160, 10
  EDITTEXT IDC_PUBLIC_HOST, 14, 106, 248, 14, ES_AUTOHSCROLL
  LTEXT "Leave hostname empty unless this PC has its own domain. The 24/7 hub is always https://gearsqueens.online/fubar/", -1, 14, 126, 248, 28
  CONTROL "Enable SDR Town website controls", IDC_SDR_CONTROL_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 150, 180, 10
  CONTROL "Frequency", IDC_SDR_CONTROL_TUNE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 168, 70, 10
  CONTROL "Mode", IDC_SDR_CONTROL_MODE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 168, 52, 10
  CONTROL "RF gain", IDC_SDR_CONTROL_GAIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 154, 168, 58, 10
  CONTROL "P25 CC", IDC_SDR_CONTROL_P25, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 214, 168, 52, 10
  LTEXT "SDR Town port:", -1, 14, 188, 80, 10
  EDITTEXT IDC_SDR_CONTROL_PORT, 100, 186, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Start SDR Town with --control-server", -1, 156, 188, 108, 10
  LTEXT "", IDC_LIVE_STATS, 14, 214, 248, 12
  DEFPUSHBUTTON "OK", IDOK, 160, 252, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 214, 252, 50, 14
END

IDD_RECORDINGS DIALOGEX 0, 0, 420, 228
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Manage recordings"
FONT 9, "Segoe UI"
BEGIN
  LISTBOX IDC_REC_LIST, 8, 8, 404, 148, LBS_EXTENDEDSEL | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
  LTEXT "", IDC_REC_STATS, 8, 160, 404, 10
  LTEXT "Delete files older than", -1, 8, 178, 90, 10
  EDITTEXT IDC_REC_DAYS, 100, 176, 32, 14, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "days", -1, 136, 178, 24, 10
  PUSHBUTTON "Delete selected", IDC_REC_DELETE, 8, 204, 80, 14
  PUSHBUTTON "Delete old files", IDC_REC_DELETE_OLD, 92, 204, 80, 14
  PUSHBUTTON "Open folder", IDC_REC_OPEN, 176, 204, 64, 14
  PUSHBUTTON "Refresh", IDC_REC_REFRESH, 244, 204, 50, 14
  PUSHBUTTON "Close", IDCANCEL, 362, 204, 50, 14
END
